# Public mainnet evidence sources
MAINNET_RPC_URL=https://free.rpc.fastnear.com
MAINNET_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.near.org
NEARBLOCKS_BASE_URL=https://api.nearblocks.io
COLLECT_INTERVAL_MS=60000
ACTIVITY_SAMPLE_BLOCKS=3
ACTIVITY_MAX_TRANSACTIONS=12

# API and database
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://underwrite:change-me@db:5432/underwrite
POSTGRES_PASSWORD=replace-with-a-long-random-password
ALLOW_MEMORY_DB=false
WEB_ORIGIN=http://localhost:4173
TRUST_PROXY=false
GENERIC_AI_ALLOWED_HOSTS=
OPERATOR_LOCAL_AI_ENABLED=false
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_INPUT_BYTES=180000
AI_MAX_CONCURRENCY=2
AI_DAILY_REQUEST_LIMIT=24

# Web: values prefixed VITE_ are public browser configuration, never secrets.
VITE_API_URL=http://localhost:8787
VITE_NEAR_NETWORK=testnet
VITE_REGISTRY_CONTRACT_ID=
VITE_TESTNET_RPC_URL=https://test.rpc.fastnear.com
